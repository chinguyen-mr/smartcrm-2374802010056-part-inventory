# ==============================================================================
# SMART CRM — QUẢN LÝ KHO LINH KIỆN THAY THẾ (LUỒNG L5)
# Tệp cấu hình mẫu biến môi trường (.env.example)
# Sao chép tệp này thành .env trước khi khởi chạy: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH CƠ SỞ DỮ LIỆU POSTGRESQL (LỚP LƯU TRỮ - STORAGE)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_crm
DB_USER=postgres
DB_PASSWORD=mật_khẩu_postgres_của_bạn

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH MÁY CHỦ BACKEND (EXPRESS.JS - PORT 3000)
# ------------------------------------------------------------------------------
APP_PORT=3000
JWT_SECRET=smartcrm_jwt_secret_dev_2026

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH GIAO DIỆN FRONTEND (REACT 19 + VITE - PORT 5173)
# (Mặc định để trống khi dùng Vite dev proxy chuyển tiếp /api -> localhost:3000)
# ------------------------------------------------------------------------------
VITE_API_URL=