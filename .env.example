# ==============================================================================
# SMART CRM — L5 PART INVENTORY — sample environment file
# Copy before starting:   cp .env.example .env
# The values below are PLACEHOLDERS that let the stack start on a local machine.
# For any shared or public deployment, replace DB_PASSWORD and JWT_SECRET.
# Never commit the real .env file (it is listed in .gitignore).
# ==============================================================================

# --- PostgreSQL --------------------------------------------------------------
# DB_HOST/DB_PORT are only used when running natively (npm start).
# Under Docker Compose the backend always connects to the "postgres" service.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_crm
DB_USER=postgres
DB_PASSWORD=change_me_local_db_password

# --- Backend (Express) -------------------------------------------------------
# Host port published for the API (container always listens on 3000).
APP_PORT=3000
# HMAC key used to sign JWTs. REQUIRED, at least 32 characters; the backend
# refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-please-use-a-random-32-plus-character-secret
# Access-token lifetime (jsonwebtoken "expiresIn" format).
JWT_EXPIRES_IN=1h
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:8088,http://localhost:5173
# Set to 1 only when the backend runs behind a TLS-terminating reverse proxy.
TRUST_PROXY=0

# --- Frontend ----------------------------------------------------------------
# Host port published for the web UI (Nginx inside the container listens on 80).
WEB_PORT=8088
# Leave empty: the UI calls /api on the same origin (Nginx or Vite dev proxy).
VITE_API_URL=
