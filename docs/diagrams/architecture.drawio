<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="arch-l5" name="Architecture L5">
    <mxGraphModel dx="2463" dy="1338" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle SO DO KIEN TRUC PHAN LOP - SMART CRM (L5 KHO LINH KIEN)\n\ntop to bottom direction\n\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam componentStyle rectangle\nskinparam packageStyle rectangle\nskinparam linetype ortho\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam nodesep 25\nskinparam ranksep 35\nskinparam ArrowColor #526579\nskinparam packageBorderColor #8295A7\nskinparam componentBorderColor #607D8B\nskinparam roundcorner 6\nskinparam dpi 150\n\n&#39; ==================================================\n&#39; LOP TRINH BAY VA NGOAI PHAM VI - HANG TREN\n&#39; ==================================================\ntogether {\n    package \&quot;LOP TRINH BAY (PRESENTATION LAYER)\&quot; #DCEAF7 {\n        component \&quot;Man hinh Danh sach linh kien\\nva Ton kho\&quot; as UI1\n        component \&quot;Man hinh Nhap kho\&quot; as UI2\n        component \&quot;Man hinh Xuat kho\\ncho phieu bao hanh\&quot; as UI3\n        component \&quot;Man hinh Canh bao\\nva Lich su giao dich\&quot; as UI4\n\n        UI1 -[hidden]right- UI2\n        UI2 -[hidden]right- UI3\n        UI3 -[hidden]right- UI4\n    }\n\n    package \&quot;NGOAI PHAM VI (MUC WON&#39;T)\&quot; #FCE4D6 {\n        component \&quot;Quan ly khach hang\\nva don hang\&quot; as OOS1\n        component \&quot;Nha cung cap va\\nDat mua linh kien\&quot; as OOS2\n        component \&quot;Ton kho san pham ban le\&quot; as OOS3\n        component \&quot;AI / Du bao\&quot; as OOS4\n\n        OOS1 -[hidden]right- OOS2\n        OOS2 -[hidden]right- OOS3\n        OOS3 -[hidden]right- OOS4\n    }\n}\n\n&#39; ==================================================\n&#39; LOP NGHIEP VU\n&#39; ==================================================\npackage \&quot;LOP NGHIEP VU (SERVICE / BUSINESS LAYER)\&quot; #E2F0D9 {\n    component \&quot;StockQueryService\\n\\nTra cuu linh kien\\nTra cuu ton theo trung tam\&quot; as StockService\n\n    component \&quot;ReceiptService\\n\\nKiem tra thong tin nhap\\nDieu phoi cap nhat ton\\nGhi nhan giao dich nhap\&quot; as ReceiptService\n\n    component \&quot;IssueService\\n\\nKiem tra ton truoc khi xuat\\nTu choi xuat vuot ton\\nGhi nhan xuat cho phieu bao hanh\&quot; as IssueService\n\n    component \&quot;ThresholdService\\n\\nSo sanh quantity\\nvoi min_threshold\\nXac dinh ton duoi nguong\&quot; as ThresholdService\n\n    StockService -[hidden]right- ReceiptService\n    ReceiptService -[hidden]right- IssueService\n    IssueService -[hidden]right- ThresholdService\n}\n\n&#39; ==================================================\n&#39; LOP TRUY CAP DU LIEU\n&#39; ==================================================\npackage \&quot;LOP TRUY CAP DU LIEU (REPOSITORY LAYER)\&quot; #FFF0D9 {\n    component \&quot;CatalogRepository\\n\\nDoc danh muc linh kien\\nDoc thong tin trung tam\&quot; as CatalogRepo\n\n    component \&quot;StockRepository\\n\\nDoc ton kho\\nCap nhat so luong ton\&quot; as StockRepo\n\n    component \&quot;TransactionRepository\\n\\nGhi / doc giao dich kho\\nDoc tham chieu phieu\\nLien ket linh kien - phieu\&quot; as TransactionRepo\n\n    CatalogRepo -[hidden]right- StockRepo\n    StockRepo -[hidden]right- TransactionRepo\n}\n\n&#39; ==================================================\n&#39; LOP LUU TRU\n&#39; ==================================================\npackage \&quot;LOP LUU TRU (DATA STORE LAYER)\&quot; #E4DFEC {\n    database \&quot;PostgreSQL DB\\n\\nservice_center\\npart\\npart_stock\\npart_transaction\\nticket_ref\\nticket_part\&quot; as DB\n}\n\n&#39; ==================================================\n&#39; GIAO TIEP: PRESENTATION -&gt; SERVICE\n&#39; ==================================================\nUI1 --&gt; StockService : HTTP/REST (JSON)\nUI2 --&gt; ReceiptService : HTTP/REST (JSON)\nUI3 --&gt; IssueService : HTTP/REST (JSON)\nUI4 --&gt; ThresholdService : HTTP/REST (JSON)\n\n&#39; ==================================================\n&#39; GIAO TIEP: SERVICE -&gt; REPOSITORY\n&#39; ==================================================\nStockService --&gt; CatalogRepo : Goi qua interface\nStockService --&gt; StockRepo : Goi qua interface\n\nReceiptService --&gt; StockRepo : Goi qua interface\nReceiptService --&gt; TransactionRepo : Goi qua interface\n\nIssueService --&gt; StockRepo : Goi qua interface\nIssueService --&gt; TransactionRepo : Goi qua interface\n\nThresholdService --&gt; StockRepo : Goi qua interface\n\n&#39; ==================================================\n&#39; GIAO TIEP: REPOSITORY -&gt; DATABASE\n&#39; ==================================================\nCatalogRepo --&gt; DB : SQL (PostgreSQL)\\nSELECT: part, service_center\n\nStockRepo --&gt; DB : SQL (PostgreSQL)\\nSELECT / UPDATE: part_stock\n\nTransactionRepo --&gt; DB : SQL (PostgreSQL)\\nINSERT / SELECT:\\npart_transaction, ticket_ref, ticket_part\n\n&#39; ==================================================\n&#39; CHU THICH\n&#39; ==================================================\nlegend bottom\n  |= Ky hieu / nhan |= Y nghia |\n  | Component | Thanh phan phan mem va trach nhiem |\n  | Package | Nhom kien truc |\n  | Mui ten lien | Huong goi xu ly / phu thuoc |\n  | HTTP/REST (JSON) | Giao tiep giua giao dien va API |\n  | Goi qua interface | Service yeu cau Repository xu ly du lieu |\n  | SQL (PostgreSQL) | Repository doc / ghi co so du lieu |\n  | Vung mau cam | Chuc nang ngoai pham vi L5 |\nendlegend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uK3QK37u8rPIeFF4joLr-560">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
