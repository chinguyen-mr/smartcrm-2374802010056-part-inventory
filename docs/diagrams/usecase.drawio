        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nskinparam backgroundColor white\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\n\ntitle Chú thích ký hiệu UML\n\n&#39; =========================\n&#39; ACTOR\n&#39; =========================\n\nactor \&quot;Actor\\n(đặt ngoài\\nranh giới hệ thống)\&quot; as ACTOR\n\n\n&#39; =========================\n&#39; USE CASE\n&#39; =========================\n\nusecase \&quot;Use case\\n(tên = động từ + đối tượng)\&quot; as UC\n\n\n&#39; =========================\n&#39; SYSTEM BOUNDARY\n&#39; =========================\n\nrectangle \&quot;Ranh giới hệ thống\\n(System boundary)\&quot; as SYSTEM\n\n\n&#39; =========================\n&#39; ASSOCIATION\n&#39; =========================\n\nrectangle \&quot; \&quot; as A\nA -[hidden] UC\n\nA2 \&quot; \&quot; as ASSOCIATION\nASSOCIATION -[hidden] A\n\n\n&#39; =========================\n&#39; INCLUDE\n&#39; =========================\n\nUC2 \&quot; \&quot; as INCLUDE_START\nUC3 \&quot; \&quot; as INCLUDE_END\n\nINCLUDE_START ..&gt; INCLUDE_END : &lt;&lt;include&gt;&gt;\n\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="O4iyTTBAqdHVWzhqgOTq-220">
