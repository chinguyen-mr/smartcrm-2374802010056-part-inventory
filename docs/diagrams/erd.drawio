<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="erd-l5" name="ERD L5">
    <mxGraphModel dx="2052" dy="2115" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ERD - KHO LINH KIEN THAY THE L5 (POSTGRESQL)\n\nleft to right direction\n\nhide methods\nhide stereotypes\nskinparam linetype ortho\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam classAttributeIconSize 0\nskinparam nodesep 55\nskinparam ranksep 60\nskinparam dpi 150\nskinparam entity {\n  BackgroundColor #FFFFFF\n  BorderColor #64809A\n  FontColor #17365D\n}\nskinparam ArrowColor #526579\n\n&#39; =================================================\n&#39; COT 1 - TRUNG TAM VA TON KHO\n&#39; =================================================\nentity \&quot;service_center\&quot; as SC {\n  * center_id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  center_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n  center_name : VARCHAR(120)\n}\n\nentity \&quot;part_stock\&quot; as PS {\n  * center_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  * part_id : BIGINT &lt;&lt;PK, FK&gt;&gt;\n  --\n  quantity : INTEGER &gt;= 0\n  min_threshold : INTEGER &gt;= 0\n  updated_at : TIMESTAMPTZ\n}\n\n&#39; =================================================\n&#39; COT 2 - DANH MUC LINH KIEN VA LIEN KET\n&#39; =================================================\nentity \&quot;part\&quot; as P {\n  * part_id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  part_code : VARCHAR(30) &lt;&lt;UQ&gt;&gt;\n  part_name : VARCHAR(120)\n  unit_price : NUMERIC(12,2) &gt;= 0\n}\n\nentity \&quot;ticket_part\&quot; as TP {\n  * ticket_part_id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  ticket_id : BIGINT &lt;&lt;FK&gt;&gt;\n  part_id : BIGINT &lt;&lt;FK&gt;&gt;\n  transaction_id : BIGINT &lt;&lt;FK&gt;&gt;\n}\n\n&#39; =================================================\n&#39; COT 3 - PHIEU THAM CHIEU VA GIAO DICH\n&#39; =================================================\nentity \&quot;ticket_ref\&quot; as TR {\n  * ticket_id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  center_id : BIGINT &lt;&lt;FK&gt;&gt;\n  ticket_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n}\n\nentity \&quot;part_transaction\&quot; as PT {\n  * transaction_id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  center_id : BIGINT &lt;&lt;FK&gt;&gt;\n  part_id : BIGINT &lt;&lt;FK&gt;&gt;\n  ticket_id : BIGINT &lt;&lt;FK, NULL&gt;&gt;\n  type : VARCHAR(10) (NHAP, XUAT)\n  quantity : INTEGER &gt; 0\n  occurred_at : TIMESTAMPTZ\n  reference : VARCHAR(80) NULL\n}\n\n&#39; =================================================\n&#39; SAP XEP CAC CUM DE HAN CHE DUONG GIAO CAT\n&#39; =================================================\nSC -[hidden]down- PS\nP -[hidden]down- TP\nTR -[hidden]down- PT\nSC -[hidden]right- P\nP -[hidden]right- TR\nPS -[hidden]right- TP\nTP -[hidden]right- PT\n\n&#39; =================================================\n&#39; CAC QUAN HE - KY HIEU CHAN CHIM\n&#39; =================================================\nSC ||--o{ PS : \&quot;center_id\&quot;\nP  ||--o{ PS : \&quot;part_id\&quot;\n\nSC ||--o{ PT : \&quot;center_id\&quot;\nP  ||--o{ PT : \&quot;part_id\&quot;\n\nSC ||--o{ TR : \&quot;center_id\&quot;\nTR ||--o{ TP : \&quot;ticket_id\&quot;\nP  ||--o{ TP : \&quot;part_id\&quot;\nPT ||--o{ TP : \&quot;transaction_id\&quot;\n\nTR |o--o{ PT : \&quot;ticket_id (NULL voi NHAP)\&quot;\n\n&#39; =================================================\n&#39; CHU THICH\n&#39; =================================================\nlegend bottom\n  |= Ky hieu |= Y nghia |\n  | PK | Khoa chinh |\n  | FK | Khoa ngoai |\n  | UQ | Gia tri duy nhat |\n  | || | Bat buoc dung mot |\n  | o| | Khong hoac mot |\n  | o{ | Khong hoac nhieu |\n  | part_stock | Khoa chinh ghep (center_id, part_id) |\n  | ticket_ref | Tham chieu toi phieu bao hanh ben ngoai |\n  | NHAP | Khong bat buoc co ticket_id |\n  | XUAT | Bat buoc co thong tin phieu bao hanh |\nendlegend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3iutK-wpP9bkOAPmBW-4-147">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
